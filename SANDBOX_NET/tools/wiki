#!/usr/local/bin/python3 -I
"""wiki: an encyclopedia article (Wikipedia) as text.

    wiki "<title or words>"         the article that fits best: Korean Wikipedia for Korean words, English otherwise
    wiki --lang en "<title>"        in another language (en, ko, ja, …)
    wiki --start 6000 "<title>"     the next part of a long article

Sections read "== Name ==". For anything else on the web: websearch "<words>", then webread <url>.
"""

import json
import os
import re
import sys
import urllib.parse

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import argus_web as W  # noqa: E402

HANGUL = re.compile(r"[가-힣]")


def api(lang: str, **query) -> str:
    return f"https://{lang}.wikipedia.org/w/api.php?" + urllib.parse.urlencode({"action": "query", "format": "json", **query})


def titles(lang: str, words: str, fetch=None) -> list[str]:
    """The articles that fit ``words``, the best first."""
    page = (fetch or W.fetch)(api(lang, list="search", srsearch=words, srlimit=6), limit=1_000_000, timeout=20)
    try:
        return [row["title"] for row in json.loads(W.text_of(page))["query"]["search"] if row.get("title")]
    except (ValueError, KeyError, TypeError):
        return []


def article(lang: str, title: str, fetch=None) -> tuple[str, str, str]:
    """-> (its title as the encyclopedia writes it, its address, its text)."""
    page = (fetch or W.fetch)(api(lang, prop="extracts|info", inprop="url", explaintext=1, exsectionformat="wiki", redirects=1, titles=title),
                 limit=6_000_000, timeout=25)
    try:
        pages = json.loads(W.text_of(page))["query"]["pages"]
        found = next(item for item in pages.values() if isinstance(item, dict) and "missing" not in item)
    except (ValueError, KeyError, TypeError, StopIteration):
        return title, "", ""
    address = found.get("fullurl") or f"https://{lang}.wikipedia.org/wiki/" + urllib.parse.quote(title.replace(" ", "_"))
    return str(found.get("title") or title), address, re.sub(r"\n{3,}", "\n\n", str(found.get("extract") or "")).strip()


def look_up(words: str, lang: str | None, fetch=None) -> tuple[str, str, str, str, list[str]]:
    """-> (language, title, address, text, the other articles that fit). The other of Korean and English is asked when
    the first has nothing and no language was named."""
    first = lang or ("ko" if HANGUL.search(words) else "en")
    tried = [first] if lang else [first, "en" if first == "ko" else "ko"]
    for name in tried:
        found = titles(name, words, fetch)
        for title in found[:3]:  # (a title may lead to an empty page: the next one then)
            real, address, text = article(name, title, fetch)
            if text:
                return name, real, address, text, [other for other in found if other not in (title, real)][:5]
    return first, "", "", "", []


def main(argv=None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if args else 2
    try:
        options, given = W.take_options(args)
        words = " ".join(given).strip()
        if not words:
            raise W.FetchError('give a title or words: wiki "<title>"')
        if options["lang"] and not re.fullmatch(r"[a-z]{2,3}(-[a-z0-9]{2,8})?", options["lang"]):
            raise W.FetchError("--lang takes a language code such as ko or en")
        lang, title, address, text, others = look_up(words, options["lang"])
    except W.FetchError as error:
        print(f"wiki: {error}", file=sys.stderr)
        return 1
    if not text:
        print(f'wiki: no article found for "{words}". Other ways: websearch "{words}", or wiki --lang en "<English title>".', file=sys.stderr)
        return 1
    piece, start, end, total = W.part(text, options["start"], options["max"])
    lines = [f"Title: {title} ({lang}.wikipedia.org)", f"URL: {address}"]
    if others:
        lines.append("Other articles that fit: " + ", ".join(others))
    lines += [f"Text: {W.span(start, end, total)}", "", piece.strip("\n")]
    if end < total:
        lines += ["", f'[The article goes on. Next part: wiki --lang {lang} --start {end} "{title}"]']
    print("\n".join(lines))
    return 0


if __name__ == "__main__":
    sys.exit(main())
