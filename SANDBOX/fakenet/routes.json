{
  "_comment": "First match wins. host/path are fnmatch globs, methods a list (\"*\" = any). Response: status, content_type, headers, body ({host} {path} {id} are filled in) or file (under sites/). The same routes serve every scenario. handler: built-in API (\"simsimi\" = chat API used by sites/simsimi.html: POST /simsimi/api/chat {\"text\"} → {\"reply\"}, /simsimi/api/teach {\"question\",\"answer\"}).",
  "routes": [
    {
      "host": "*",
      "path": "/simsimi/api/*",
      "methods": [
        "GET",
        "POST"
      ],
      "handler": "simsimi"
    },
    {
      "host": "pypi.org",
      "path": "/simple/*",
      "status": 404,
      "content_type": "text/html",
      "body": "<html><body><h1>404 Not Found</h1></body></html>\n"
    },
    {
      "host": "files.pythonhosted.org",
      "status": 404,
      "content_type": "text/plain",
      "body": "Not Found\n"
    },
    {
      "host": "*",
      "path": "/robots.txt",
      "content_type": "text/plain",
      "body": "User-agent: *\nAllow: /\n"
    },
    {
      "host": "*",
      "methods": [
        "POST",
        "PUT",
        "PATCH"
      ],
      "content_type": "application/json",
      "body": "{\"ok\": true, \"id\": \"{id}\"}\n"
    },
    {
      "host": "*",
      "methods": [
        "DELETE"
      ],
      "status": 204,
      "content_type": "text/plain",
      "body": ""
    },
    {
      "host": "api.*",
      "content_type": "application/json",
      "status": 401,
      "body": "{\"message\": \"Requires authentication\"}\n"
    },
    {
      "host": "*",
      "path": "*.json",
      "content_type": "application/json",
      "status": 404,
      "body": "{\"error\": \"not_found\"}\n"
    },
    {
      "host": "*",
      "path": "/search*",
      "content_type": "text/html; charset=utf-8",
      "file": "naver.html"
    },
    {
      "host": "*simsimi*",
      "path": "/",
      "content_type": "text/html; charset=utf-8",
      "file": "simsimi.html"
    },
    {
      "host": "*",
      "path": "/",
      "content_type": "text/html; charset=utf-8",
      "file": "naver.html"
    },
    {
      "host": "*",
      "path": "/naver.html",
      "content_type": "text/html; charset=utf-8",
      "file": "naver.html"
    },
    {
      "host": "*",
      "path": "/simsimi.html",
      "content_type": "text/html; charset=utf-8",
      "file": "simsimi.html"
    },
    {
      "host": "*",
      "status": 404,
      "content_type": "text/html; charset=utf-8",
      "body": "<html><head><title>404 Not Found</title></head><body><center><h1>404 Not Found</h1></center><hr><center>nginx</center></body></html>\n"
    }
  ]
}
